  // Never put a secret (VIVA_TOKEN_SECRET and friends) in this file; set secrets in Cloudflare.
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://iibfcgrxcoskpduoxayk.supabase.co",
      "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_KJhR_HeYWgn9o67V74C9KA_OEVOH6nj",
      "VITE_ORALBOT_BACKEND": "https://api.cognifyinstitute.com"
    }
  }
}
