# Copy this file to `.env` and fill in the real values.
# These are required for the AI Oral Viva backend to start.

# Deepgram API key for speech-to-text (used by /transcribe/)
DEEPGRAM_API_KEY=

# Gemini API key for answer evaluation (used by /viva/evaluation/)
GEMINI_API_KEY=

# Optional: comma-separated list of allowed browser origins for CORS.
# Leave unset for local development (defaults to localhost).
# Example: CORS_ORIGINS=https://app.cognify.in,https://www.cognify.in
CORS_ORIGINS=

# Secret used to verify the Viva access tokens the Cloudflare site issues.
# Must be exactly the same value as VIVA_TOKEN_SECRET on the Cloudflare site.
# Generate one with: openssl rand -hex 32
VIVA_TOKEN_SECRET=
